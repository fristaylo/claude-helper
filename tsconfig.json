{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node", "vscode"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx"
	},
	"include": ["src"],
	"exclude": ["src/agent.check.ts"]
}
