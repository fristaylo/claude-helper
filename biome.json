{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": { "ignore": ["dist", "releases", "node_modules"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 110 },
	"linter": {
		"rules": {
			"recommended": true,
			"suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
			"a11y": {
				"useKeyWithClickEvents": "off",
				"noAutofocus": "off",
				"noLabelWithoutControl": {
					"level": "error",
					"options": { "inputComponents": ["Checkbox", "Switch"] }
				}
			},
			"security": { "noDangerouslySetInnerHtml": "off" }
		}
	}
}
